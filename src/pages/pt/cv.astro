---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TimeLineElement from "../../components/cv/TimeLine.astro";
import TechStack from "../../components/TechStack.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "../../i18n/utils";

const lang = "pt";
const t = useTranslations(lang);
---

<BaseLayout title="Currículo — Dangerousplay" sideBarActiveItemID="cv" lang={lang}>

  <section class="mb-10 mt-6">
    <div class="anim-fade-up eyebrow mb-3">{t('cv.eyebrow')}</div>
    <h1 class="anim-fade-up-2 text-4xl font-extrabold text-1">{t('cv.title')}</h1>
  </section>

  <!-- Perfil -->
  <section class="anim-fade-up-3 mb-12">
    <div class="section-head">
      <div class="icon-tile w-9 h-9 rounded-lg"><Icon name="lucide:user-round" /></div>
      <h2 class="text-2xl font-bold">{t('cv.profile')}</h2>
    </div>
    <p class="body-text max-w-2xl">{t('cv.profile.body')}</p>
  </section>

  <!-- Educação -->
  <section class="mb-12">
    <div class="section-head">
      <div class="icon-tile w-9 h-9 rounded-lg"><Icon name="lucide:graduation-cap" /></div>
      <h2 class="text-2xl font-bold">{t('cv.education')}</h2>
    </div>
    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title="Pós-graduação — Liderança para Inovação"
        subtitle="Unilasalle · Rio Grande do Sul, Brasil"
      />
      <TimeLineElement
        title="Bacharelado em Ciência da Computação"
        subtitle="Unilasalle · Formado em 2023 · Rio Grande do Sul, Brasil"
      />
    </div>
  </section>

  <!-- Experiência -->
  <section class="mb-12">
    <div class="section-head">
      <div class="icon-tile amber w-9 h-9 rounded-lg"><Icon name="lucide:briefcase" /></div>
      <h2 class="text-2xl font-bold">{t('cv.experience')}</h2>
    </div>
    <div class="time-line-container">
      <TimeLineElement
        title="Engenheiro de Plataforma Especialista · Sicredi"
        subtitle="Jan 2026 – Presente · Rio Grande do Sul, Brasil"
      >
        Engenharia de plataforma, DevOps e confiabilidade ao longo do ciclo de entrega
        de software. Projeto sistemas escaláveis e observáveis de ponta a ponta —
        Kubernetes e contêineres, CI/CD, infraestrutura como código e observabilidade
        com Prometheus, Grafana e OpenTelemetry.
      </TimeLineElement>
      <TimeLineElement
        title="Desenvolvedor DevOps / Engenheiro de Software · Sicredi"
        subtitle="Jun 2022 – Presente · Rio Grande do Sul, Brasil"
      >
        Desenvolvimento de automações e aplicações para gerenciar a infraestrutura e
        todo o ciclo de desenvolvimento de software. Serviços de backend e ferramentas
        de plataforma em Java, Kotlin e Go, rodando em Kubernetes.
      </TimeLineElement>
      <TimeLineElement
        title="Desenvolvedor de Software DevOps · Sicredi"
        subtitle="Jan 2020 – Jun 2022 · Porto Alegre, Brasil"
      >
        Desenvolvimento de software munido de práticas DevOps — entregando sistemas de
        backend e a automação ao seu redor.
      </TimeLineElement>
      <TimeLineElement
        title="Desenvolvedor de Software Júnior · NTConsult"
        subtitle="Jul 2018 – Jan 2020 · Porto Alegre, Brasil"
      >
        Início da minha carreira profissional em software, depois de começar
        construindo backends em Java para um servidor de Minecraft — concorrência,
        rede de baixa latência e serviços resilientes em tempo real.
      </TimeLineElement>
    </div>
  </section>

  <!-- Habilidades -->
  <section class="mb-8">
    <div class="section-head">
      <div class="icon-tile amber w-9 h-9 rounded-lg"><Icon name="lucide:wrench" /></div>
      <h2 class="text-2xl font-bold">{t('cv.skills')}</h2>
    </div>
    <p class="text-sm muted-text mb-6">{t('cv.skills.sub')}</p>
    <TechStack />
  </section>

</BaseLayout>

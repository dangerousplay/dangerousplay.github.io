---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TimeLineElement from "../../components/cv/TimeLine.astro";
import TechStack from "../../components/TechStack.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "../../i18n/utils";

const lang = "pt";
const t = useTranslations(lang);
---

<BaseLayout title="Currículo — Dangerousplay" sideBarActiveItemID="cv" lang={lang}>

  <section class="mb-10 mt-6">
    <div class="anim-fade-up eyebrow mb-3">{t('cv.eyebrow')}</div>
    <h1 class="anim-fade-up-2 text-4xl font-extrabold text-1">{t('cv.title')}</h1>
  </section>

  <!-- Perfil -->
  <section class="anim-fade-up-3 mb-12">
    <div class="section-head">
      <div class="icon-tile w-9 h-9 rounded-lg"><Icon name="lucide:user-round" /></div>
      <h2 class="text-2xl font-bold">{t('cv.profile')}</h2>
    </div>
    <p class="body-text max-w-2xl">{t('cv.profile.body')}</p>
  </section>

  <!-- Educação -->
  <section class="mb-12">
    <div class="section-head">
      <div class="icon-tile w-9 h-9 rounded-lg"><Icon name="lucide:graduation-cap" /></div>
      <h2 class="text-2xl font-bold">{t('cv.education')}</h2>
    </div>
    <div class="time-line-container grid gap-4">
      <TimeLineElement title="Título do Curso" subtitle="[ano início] a [ano fim] na [Instituição], [Cidade], [País]" />
      <TimeLineElement title="Título do Curso" subtitle="[ano início] a [ano fim] na [Instituição], [Cidade], [País]" />
    </div>
  </section>

  <!-- Experiência -->
  <section class="mb-12">
    <div class="section-head">
      <div class="icon-tile amber w-9 h-9 rounded-lg"><Icon name="lucide:briefcase" /></div>
      <h2 class="text-2xl font-bold">{t('cv.experience')}</h2>
    </div>
    <div class="time-line-container">
      <TimeLineElement title="Cargo na Empresa" subtitle="De [Data Início] a [Data Fim] na [Empresa], [Cidade], [País]">
        Descreva uma responsabilidade chave, os sistemas que você manteve e o impacto que teve.
      </TimeLineElement>
      <TimeLineElement title="Cargo na Empresa" subtitle="De [Data Início] a [Data Fim] na [Empresa], [Cidade], [País]">
        Descreva uma responsabilidade chave, os sistemas que você manteve e o impacto que teve.
      </TimeLineElement>
    </div>
  </section>

  <!-- Certificações -->
  <section class="mb-12">
    <div class="section-head">
      <div class="icon-tile w-9 h-9 rounded-lg"><Icon name="lucide:award" /></div>
      <h2 class="text-2xl font-bold">{t('cv.certifications')}</h2>
    </div>
    <ul class="cert-list grid gap-2 max-w-xl">
      <li>
        <Icon name="lucide:badge-check" class="cert-icon" />
        <a href="#" target="_blank">Nome da Certificação (com link)</a>
      </li>
    </ul>
  </section>

  <!-- Habilidades -->
  <section class="mb-8">
    <div class="section-head">
      <div class="icon-tile amber w-9 h-9 rounded-lg"><Icon name="lucide:wrench" /></div>
      <h2 class="text-2xl font-bold">{t('cv.skills')}</h2>
    </div>
    <p class="text-sm muted-text mb-6">{t('cv.skills.sub')}</p>
    <TechStack />
  </section>

</BaseLayout>

<style>
  .cert-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--token-text-2);
  }
  .cert-icon { width: 1.05rem; height: 1.05rem; color: var(--token-primary); flex-shrink: 0; }
  .cert-list a { text-decoration: none; transition: color 0.2s ease; }
  .cert-list a:hover { color: var(--token-primary); }
</style>

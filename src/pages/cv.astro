---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import TechStack from "../components/TechStack.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
---

<BaseLayout title="Resume — Dangerousplay" sideBarActiveItemID="cv" lang={lang}>

  <section class="mb-10 mt-6">
    <div class="anim-fade-up eyebrow mb-3">{t('cv.eyebrow')}</div>
    <h1 class="anim-fade-up-2 text-4xl font-extrabold text-1">{t('cv.title')}</h1>
  </section>

  <!-- Profile -->
  <section class="anim-fade-up-3 mb-12">
    <div class="section-head">
      <div class="icon-tile w-9 h-9 rounded-lg"><Icon name="lucide:user-round" /></div>
      <h2 class="text-2xl font-bold">{t('cv.profile')}</h2>
    </div>
    <p class="body-text max-w-2xl">{t('cv.profile.body')}</p>
  </section>

  <!-- Education -->
  <section class="mb-12">
    <div class="section-head">
      <div class="icon-tile w-9 h-9 rounded-lg"><Icon name="lucide:graduation-cap" /></div>
      <h2 class="text-2xl font-bold">{t('cv.education')}</h2>
    </div>
    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title="Postgraduate — Leadership for Innovation"
        subtitle="Unilasalle · Rio Grande do Sul, Brazil"
      />
      <TimeLineElement
        title="Bachelor's Degree in Computer Science"
        subtitle="Unilasalle · Graduated 2023 · Rio Grande do Sul, Brazil"
      />
    </div>
  </section>

  <!-- Experience -->
  <section class="mb-12">
    <div class="section-head">
      <div class="icon-tile amber w-9 h-9 rounded-lg"><Icon name="lucide:briefcase" /></div>
      <h2 class="text-2xl font-bold">{t('cv.experience')}</h2>
    </div>
    <div class="time-line-container">
      <TimeLineElement
        title="Specialist Platform Engineer · Sicredi"
        subtitle="Jan 2026 – Present · Rio Grande do Sul, Brazil"
      >
        Platform engineering, DevOps, and reliability across the software-delivery
        lifecycle. I design scalable, observable systems end to end — Kubernetes and
        containers, CI/CD, infrastructure as code, and observability with Prometheus,
        Grafana, and OpenTelemetry.
      </TimeLineElement>
      <TimeLineElement
        title="DevOps Developer / Software Engineer · Sicredi"
        subtitle="Jun 2022 – Present · Rio Grande do Sul, Brazil"
      >
        Build automations and applications to manage infrastructure and the full
        software development lifecycle. Backend services and platform tooling in Java,
        Kotlin, and Go, running on Kubernetes.
      </TimeLineElement>
      <TimeLineElement
        title="DevOps Software Developer · Sicredi"
        subtitle="Jan 2020 – Jun 2022 · Porto Alegre, Brazil"
      >
        Software development driven by DevOps practices — shipping backend systems and
        the automation around them.
      </TimeLineElement>
      <TimeLineElement
        title="Junior Software Developer · NTConsult"
        subtitle="Jul 2018 – Jan 2020 · Porto Alegre, Brazil"
      >
        Started my professional software career, after cutting my teeth building Java
        backends for a Minecraft server — concurrency, low-latency networking, and
        resilient real-time services.
      </TimeLineElement>
    </div>
  </section>

  <!-- Skills -->
  <section class="mb-8">
    <div class="section-head">
      <div class="icon-tile amber w-9 h-9 rounded-lg"><Icon name="lucide:wrench" /></div>
      <h2 class="text-2xl font-bold">{t('cv.skills')}</h2>
    </div>
    <p class="text-sm muted-text mb-6">{t('cv.skills.sub')}</p>
    <TechStack />
  </section>

</BaseLayout>

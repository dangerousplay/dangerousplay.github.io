---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { techStack } from "../data/tech";

const name = "Dangerousplay";
const roles = ["Philosopher", "Platform Engineer", "Philanthropist", "Furry Lion 🦁"];
const bio =
  "Platform engineer by day, philosopher at heart — building systems that scale, securing what matters, and inspiring others to live with purpose.";
const stats = [
  { v: "6+", l: "Years building" },
  { v: "14", l: "Core tools" },
  { v: "EN·PT", l: "Languages" },
];
const techs = techStack.slice(0, 10);
const featured = {
  name: "Novatera",
  tag: "Active · Philanthropy",
  desc: "A platform to connect people and inspire the practice of good — where kindness and technology meet to make real impact.",
};
const project2 = {
  name: "Vault Policy Escalation Checker",
  desc: "Interactive tool to validate HashiCorp Vault escalation policies before misconfigurations become incidents.",
};

const concepts = [
  { id: "nocturne", name: "Nocturne", note: "Topbar · glass · indigo→teal" },
  { id: "paper", name: "Paper", note: "Editorial · serif · warm light" },
  { id: "bento", name: "Bento", note: "Tile grid · vibrant gradient" },
  { id: "console", name: "Console", note: "Terminal · mono · phosphor" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Design Lab — Dangerousplay</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,300..600&family=JetBrains+Mono:wght@400;500;600&family=Inter:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="lab-body">
    <!-- Sticky lab nav -->
    <header class="lab-bar">
      <div class="lab-bar-title">
        <span class="lab-dot"></span> Design Lab
        <span class="lab-bar-sub">— rethinking the personal site</span>
      </div>
      <nav class="lab-jump">
        {concepts.map((c) => (
          <a href={`#${c.id}`} class="lab-jump-link">{c.name}</a>
        ))}
      </nav>
    </header>

    {/* ════════════════ CONCEPT 1 · NOCTURNE ════════════════ */}
    <section id="nocturne" class="cc cc-nocturne">
      <div class="cc-label"><span>01</span> Nocturne — topbar · glass · indigo→teal</div>
      <div class="noc">
        <header class="noc-nav">
          <div class="noc-brand"><span class="noc-mono">DP</span> {name}</div>
          <nav class="noc-links"><a class="on">Home</a><a>Projects</a><a>Blog</a><a>Resume</a><a class="noc-cta">Contact</a></nav>
        </header>
        <div class="noc-hero">
          <div class="noc-avatar"><Image src="/profile.jpg" alt={name} width={160} height={160} format="webp" /></div>
          <p class="noc-eyebrow">Philosopher · Platform Engineer · Furry Lion</p>
          <h1 class="noc-name">{name}</h1>
          <div class="noc-roles">{roles.map((r) => <span>{r}</span>)}</div>
          <p class="noc-bio">{bio}</p>
          <div class="noc-stats">
            {stats.map((s) => (
              <div class="noc-stat"><b>{s.v}</b><span>{s.l}</span></div>
            ))}
          </div>
        </div>
        <div class="noc-tech">
          {techs.map((t) => (
            <span class="noc-chip" style={`--b:${t.color}`}><Icon name={t.icon} /> {t.name}</span>
          ))}
        </div>
        <div class="noc-proj">
          <div class="noc-proj-ic"><Icon name="lucide:globe" /></div>
          <div>
            <div class="noc-proj-tag">{featured.tag}</div>
            <h3>{featured.name}</h3>
            <p>{featured.desc}</p>
          </div>
          <button class="noc-btn">Visit →</button>
        </div>
      </div>
    </section>

    {/* ════════════════ CONCEPT 2 · PAPER ════════════════ */}
    <section id="paper" class="cc cc-paper">
      <div class="cc-label"><span>02</span> Paper — editorial · serif · warm light</div>
      <div class="pap">
        <header class="pap-nav">
          <span class="pap-brand">{name}</span>
          <nav><a class="on">Home</a><a>Projects</a><a>Blog</a><a>Resume</a><a>Contact</a></nav>
        </header>
        <div class="pap-hero">
          <div class="pap-left">
            <p class="pap-kicker">Philosopher · Platform Engineer</p>
            <h1 class="pap-name">{name}</h1>
            <p class="pap-bio">{bio}</p>
            <div class="pap-cta"><button class="pap-btn">Explore projects</button><a class="pap-link">Read the blog →</a></div>
          </div>
          <aside class="pap-right">
            <div class="pap-photo"><Image src="/profile.jpg" alt={name} width={120} height={120} format="webp" /></div>
            <ul class="pap-meta">
              <li><span>Location</span> Brazil</li>
              <li><span>Focus</span> Platform · Security</li>
              <li><span>Langs</span> EN · PT</li>
            </ul>
          </aside>
        </div>
        <div class="pap-rule"></div>
        <div class="pap-projects">
          <a class="pap-row"><span class="pap-num">01</span><div><h3>{featured.name}</h3><p>{featured.desc}</p></div><span class="pap-arr">→</span></a>
          <a class="pap-row"><span class="pap-num">02</span><div><h3>{project2.name}</h3><p>{project2.desc}</p></div><span class="pap-arr">→</span></a>
        </div>
      </div>
    </section>

    {/* ════════════════ CONCEPT 3 · BENTO ════════════════ */}
    <section id="bento" class="cc cc-bento">
      <div class="cc-label"><span>03</span> Bento — tile grid · vibrant gradient</div>
      <div class="ben">
        <header class="ben-nav">
          <div class="ben-brand"><span class="ben-mono">DP</span></div>
          <nav><a class="on">Home</a><a>Projects</a><a>Blog</a><a>Resume</a></nav>
          <button class="ben-cta">Let's talk</button>
        </header>
        <div class="ben-grid">
          <div class="ben-tile ben-hello">
            <p class="ben-eyebrow">Hey, I'm</p>
            <h1 class="ben-name">{name}</h1>
            <p class="ben-bio">{bio}</p>
          </div>
          <div class="ben-tile ben-photo"><Image src="/profile.jpg" alt={name} width={200} height={200} format="webp" /></div>
          {stats.map((s) => (
            <div class="ben-tile ben-stat"><b>{s.v}</b><span>{s.l}</span></div>
          ))}
          <div class="ben-tile ben-tech">
            <p class="ben-tile-h">Stack</p>
            <div class="ben-tech-row">{techs.slice(0,8).map((t) => <span style={`--b:${t.color}`}><Icon name={t.icon} /></span>)}</div>
          </div>
          <div class="ben-tile ben-proj">
            <div class="ben-proj-tag">{featured.tag}</div>
            <h3>{featured.name}</h3>
            <p>{featured.desc}</p>
            <span class="ben-proj-arr"><Icon name="lucide:arrow-up-right" /></span>
          </div>
          <div class="ben-tile ben-blog"><p class="ben-tile-h">Latest</p><h4>Heapsort, why it's efficient?</h4></div>
        </div>
      </div>
    </section>

    {/* ════════════════ CONCEPT 4 · CONSOLE ════════════════ */}
    <section id="console" class="cc cc-console">
      <div class="cc-label"><span>04</span> Console — terminal · mono · phosphor</div>
      <div class="con">
        <div class="con-winbar"><span class="con-dot r"></span><span class="con-dot y"></span><span class="con-dot g"></span><span class="con-path">~/dangerousplay — zsh</span></div>
        <div class="con-body">
          <aside class="con-side">
            <p class="con-side-h">EXPLORER</p>
            <a class="on">▸ home.md</a><a>▸ projects/</a><a>▸ blog/</a><a>▸ resume.pdf</a><a>▸ contact</a>
          </aside>
          <main class="con-main">
            <p class="con-line"><span class="con-prompt">dangerousplay@web</span>:<span class="con-dir">~</span>$ whoami</p>
            <h1 class="con-name">{name}</h1>
            <p class="con-roles">// Philosopher · Platform Engineer · Philanthropist · Furry Lion 🦁</p>
            <p class="con-bio">{bio}</p>
            <p class="con-line con-mt"><span class="con-prompt">dangerousplay@web</span>:<span class="con-dir">~</span>$ cat stack.txt</p>
            <div class="con-stack">{techs.map((t) => <span style={`--b:${t.color}`}><Icon name={t.icon} /> {t.name.toLowerCase()}</span>)}</div>
            <p class="con-line con-mt"><span class="con-prompt">dangerousplay@web</span>:<span class="con-dir">~</span>$ ls projects/</p>
            <div class="con-proj">
              <div class="con-card"><span class="con-tag">{featured.tag}</span><h3>{featured.name}</h3><p>{featured.desc}</p></div>
              <div class="con-card"><span class="con-tag">tool</span><h3>{project2.name}</h3><p>{project2.desc}</p></div>
            </div>
            <p class="con-line con-mt"><span class="con-prompt">dangerousplay@web</span>:<span class="con-dir">~</span>$ <span class="con-cursor">█</span></p>
          </main>
        </div>
      </div>
    </section>

    <footer class="lab-foot">Design Lab · 4 concepts · reuse content/images/icons · tell me which to ship</footer>

    <script is:inline>
      (function () {
        var links = document.querySelectorAll(".lab-jump-link");
        var secs = document.querySelectorAll(".cc");
        var map = {};
        links.forEach(function (l) { map[l.getAttribute("href").slice(1)] = l; });
        var obs = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting) {
              links.forEach(function (l) { l.classList.remove("on"); });
              if (map[e.target.id]) map[e.target.id].classList.add("on");
            }
          });
        }, { rootMargin: "-45% 0px -50% 0px" });
        secs.forEach(function (s) { obs.observe(s); });
      })();
    </script>

    <style is:global>
      body.lab-body { background: #05060a; color: #e8ecf7; font-family: 'Inter', system-ui, sans-serif; }
    </style>

    <style>
      /* ── Lab chrome ── */
      .lab-bar {
        position: sticky; top: 0; z-index: 100;
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
        padding: 0.7rem 1.25rem;
        background: rgba(8, 10, 18, 0.82); backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }
      .lab-bar-title { font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem; }
      .lab-bar-sub { font-weight: 400; opacity: 0.45; font-size: 0.82rem; }
      .lab-dot { width: 9px; height: 9px; border-radius: 50%; background: linear-gradient(135deg,#5b8cff,#36e0c8); box-shadow: 0 0 10px #5b8cff; }
      .lab-jump { display: flex; gap: 0.3rem; flex-wrap: wrap; }
      .lab-jump-link { font-size: 0.8rem; padding: 0.32rem 0.7rem; border-radius: 999px; color: #aeb6c9; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: .2s; }
      .lab-jump-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
      .lab-jump-link.on { color: #fff; border-color: rgba(255,255,255,0.18); background: rgba(255,255,255,0.08); }

      .cc { position: relative; padding: 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
      .cc-label {
        position: sticky; top: 49px; z-index: 20;
        font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 0.5rem 1.25rem; color: #fff;
        background: rgba(8,10,18,0.7); backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(255,255,255,0.06);
      }
      .cc-label span { font-family: 'JetBrains Mono', monospace; opacity: 0.5; margin-right: 0.5rem; }
      .lab-foot { text-align: center; padding: 2.5rem 1rem; color: #6b7488; font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; }

      /* ═══════════ 1 · NOCTURNE ═══════════ */
      .cc-nocturne { --bg:#0b0f1e; --p:#5b8cff; --a:#36e0c8; --t1:#eef2fb; --t2:#aab3c9; --t3:#6b7488; --surf:rgba(255,255,255,.04); --bd:rgba(255,255,255,.09); }
      .noc { background:
          radial-gradient(700px 400px at 15% 0%, rgba(91,140,255,.16), transparent 60%),
          radial-gradient(600px 380px at 90% 5%, rgba(54,224,200,.13), transparent 60%),
          var(--bg);
        font-family: 'Space Grotesk', sans-serif; padding: 0 1.5rem 3.5rem; }
      .noc-nav { max-width: 980px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 0; }
      .noc-brand { display: flex; align-items: center; gap: .55rem; font-weight: 600; color: var(--t1); }
      .noc-mono { display:grid; place-items:center; width:30px; height:30px; border-radius:9px; font-size:.72rem; font-weight:700; color:#06121f; background:linear-gradient(135deg,var(--p),var(--a)); }
      .noc-links { display: flex; gap: .35rem; align-items: center; }
      .noc-links a { font-size: .85rem; color: var(--t3); padding: .4rem .7rem; border-radius: 8px; cursor: pointer; }
      .noc-links a.on, .noc-links a:hover { color: var(--t1); }
      .noc-links a.noc-cta { color:#06121f; background: var(--a); font-weight:600; }
      .noc-hero { max-width: 720px; margin: 1.5rem auto 0; text-align: center; }
      .noc-avatar img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px var(--a), 0 0 32px rgba(54,224,200,.4); }
      .noc-eyebrow { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--a); margin: 1rem 0 .3rem; }
      .noc-name { font-size: clamp(2.6rem,7vw,4rem); font-weight: 700; line-height: 1; margin: 0; background: linear-gradient(120deg,var(--p),var(--a)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .noc-roles { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin: 1.1rem 0; }
      .noc-roles span { font-size: .74rem; padding: .28rem .75rem; border-radius: 999px; background: var(--surf); border: 1px solid var(--bd); color: var(--t2); }
      .noc-bio { color: var(--t2); line-height: 1.65; max-width: 46ch; margin: 0 auto; }
      .noc-stats { display: flex; justify-content: center; gap: .75rem; margin-top: 1.5rem; }
      .noc-stat { background: var(--surf); border: 1px solid var(--bd); border-radius: 12px; padding: .8rem 1.2rem; backdrop-filter: blur(10px); }
      .noc-stat b { display: block; font-size: 1.4rem; color: var(--t1); }
      .noc-stat span { font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--t3); }
      .noc-tech { max-width: 820px; margin: 2.25rem auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
      .noc-chip { display: inline-flex; align-items: center; gap: .4rem; font-size: .78rem; color: var(--t2); padding: .4rem .7rem; border-radius: 999px; background: var(--surf); border: 1px solid var(--bd); }
      .noc-chip svg { width: 1rem; height: 1rem; color: var(--b); }
      .noc-proj { max-width: 820px; margin: 1.75rem auto 0; display: flex; align-items: center; gap: 1.1rem; padding: 1.4rem; border-radius: 16px; background: var(--surf); border: 1px solid var(--bd); }
      .noc-proj-ic { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: linear-gradient(135deg,var(--p),var(--a)); color: #06121f; flex-shrink: 0; }
      .noc-proj-ic svg { width: 1.4rem; height: 1.4rem; }
      .noc-proj-tag { font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: var(--a); }
      .noc-proj h3 { margin: .15rem 0; color: var(--t1); font-size: 1.15rem; font-weight: 600; }
      .noc-proj p { color: var(--t2); font-size: .85rem; margin: 0; }
      .noc-btn { margin-left: auto; align-self: center; white-space: nowrap; padding: .5rem 1rem; border-radius: 10px; border: none; cursor: pointer; font-weight: 600; color: #06121f; background: var(--a); }

      /* ═══════════ 2 · PAPER ═══════════ */
      .pap { background: radial-gradient(700px 420px at 12% 0%, rgba(199,93,60,.10), transparent 58%), #f3ede2; color: #2a2018; font-family: 'Inter', sans-serif; padding: 0 1.75rem 3.5rem; }
      .pap-nav { max-width: 960px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 1.2rem 0; border-bottom: 1px solid rgba(60,40,20,.12); }
      .pap-brand { font-family: 'Fraunces', serif; font-size: 1.25rem; font-weight: 500; }
      .pap-nav nav { display: flex; gap: 1rem; }
      .pap-nav a { font-size: .85rem; color: #7a6a55; cursor: pointer; }
      .pap-nav a.on, .pap-nav a:hover { color: #c75d3c; }
      .pap-hero { max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: 1.6fr 1fr; gap: 2.5rem; padding: 3rem 0; align-items: start; }
      .pap-kicker { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: #c75d3c; margin: 0 0 .75rem; }
      .pap-name { font-family: 'Fraunces', serif; font-weight: 500; font-size: clamp(3rem,8vw,5rem); line-height: .98; letter-spacing: -.02em; margin: 0; }
      .pap-bio { font-family: 'Fraunces', serif; font-weight: 300; font-size: 1.3rem; line-height: 1.5; color: #4a3d30; margin: 1.5rem 0; max-width: 32ch; }
      .pap-cta { display: flex; align-items: center; gap: 1.25rem; }
      .pap-btn { padding: .6rem 1.2rem; border-radius: 8px; border: none; background: #c75d3c; color: #fff; font-weight: 600; cursor: pointer; }
      .pap-link { color: #2a2018; font-weight: 500; cursor: pointer; border-bottom: 1px solid #c75d3c; }
      .pap-right { padding-top: .5rem; }
      .pap-photo img { width: 96px; height: 96px; border-radius: 14px; object-fit: cover; }
      .pap-meta { list-style: none; padding: 0; margin: 1.5rem 0 0; }
      .pap-meta li { display: flex; justify-content: space-between; padding: .65rem 0; border-bottom: 1px solid rgba(60,40,20,.12); font-size: .9rem; }
      .pap-meta span { color: #9a8a72; }
      .pap-rule { max-width: 960px; margin: 0 auto; height: 1px; background: rgba(60,40,20,.14); }
      .pap-projects { max-width: 960px; margin: 0 auto; }
      .pap-row { display: flex; gap: 1.25rem; align-items: center; padding: 1.6rem 0; border-bottom: 1px solid rgba(60,40,20,.12); cursor: pointer; }
      .pap-num { font-family: 'Fraunces', serif; font-size: 1.6rem; color: #c75d3c; opacity: .6; }
      .pap-row h3 { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.4rem; margin: 0; }
      .pap-row p { color: #6a5b48; font-size: .9rem; margin: .25rem 0 0; }
      .pap-arr { margin-left: auto; color: #c75d3c; font-size: 1.3rem; }

      /* ═══════════ 3 · BENTO ═══════════ */
      .ben { background: radial-gradient(600px 400px at 10% 0%, rgba(139,92,246,.2), transparent 55%), radial-gradient(600px 400px at 95% 10%, rgba(236,72,153,.16), transparent 55%), #0c0913; font-family: 'Space Grotesk', sans-serif; padding: 0 1.5rem 3.5rem; }
      .ben-nav { max-width: 1000px; margin: 0 auto; display: flex; align-items: center; gap: 1rem; padding: 1.1rem 0; }
      .ben-mono { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; font-weight: 700; color: #fff; background: linear-gradient(135deg,#8b5cf6,#ec4899); }
      .ben-nav nav { display: flex; gap: 1rem; margin-left: 1rem; }
      .ben-nav a { font-size: .85rem; color: #9a93ad; cursor: pointer; }
      .ben-nav a.on, .ben-nav a:hover { color: #fff; }
      .ben-cta { margin-left: auto; padding: .5rem 1rem; border-radius: 999px; border: none; cursor: pointer; font-weight: 600; color: #fff; background: linear-gradient(135deg,#8b5cf6,#ec4899); }
      .ben-grid { max-width: 1000px; margin: 1rem auto 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; grid-auto-rows: minmax(120px, auto); }
      .ben-tile { border-radius: 18px; padding: 1.3rem; background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.09); backdrop-filter: blur(12px); }
      .ben-hello { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; justify-content: center; background: linear-gradient(135deg, rgba(139,92,246,.22), rgba(236,72,153,.14)); }
      .ben-eyebrow { color: #d7c9ff; font-size: .8rem; }
      .ben-name { font-size: clamp(2.2rem,5vw,3.4rem); font-weight: 700; line-height: 1; margin: .25rem 0 .75rem; background: linear-gradient(120deg,#c4b5fd,#f9a8d4,#fcd34d); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .ben-bio { color: #b9b2ca; font-size: .92rem; line-height: 1.55; }
      .ben-photo { grid-column: span 2; padding: 0; overflow: hidden; }
      .ben-photo img { width: 100%; height: 100%; object-fit: cover; }
      .ben-stat { display: flex; flex-direction: column; justify-content: center; }
      .ben-stat b { font-size: 1.8rem; background: linear-gradient(120deg,#a78bfa,#f472b6); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .ben-stat span { color: #8e87a3; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; }
      .ben-tile-h { font-size: .68rem; text-transform: uppercase; letter-spacing: .12em; color: #8e87a3; margin: 0 0 .6rem; }
      .ben-tech { grid-column: span 2; }
      .ben-tech-row { display: flex; flex-wrap: wrap; gap: .55rem; }
      .ben-tech-row span { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; background: rgba(255,255,255,.05); }
      .ben-tech-row svg { width: 1.25rem; height: 1.25rem; color: var(--b); }
      .ben-proj { grid-column: span 2; grid-row: span 2; position: relative; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(160deg, rgba(236,72,153,.18), rgba(245,158,11,.12)); }
      .ben-proj-tag { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: #fcd34d; }
      .ben-proj h3 { font-size: 1.5rem; margin: .3rem 0; color: #fff; }
      .ben-proj p { color: #c9c2d6; font-size: .88rem; }
      .ben-proj-arr { position: absolute; top: 1.3rem; right: 1.3rem; color: #fff; }
      .ben-proj-arr svg { width: 1.4rem; height: 1.4rem; }
      .ben-blog { grid-column: span 2; }
      .ben-blog h4 { color: #e8e2f2; font-size: 1.05rem; margin: 0; }
      @media (max-width: 760px) { .ben-grid { grid-template-columns: repeat(2, 1fr); } .ben-hello, .ben-photo, .ben-tech, .ben-proj { grid-column: span 2; } }

      /* ═══════════ 4 · CONSOLE ═══════════ */
      .con { background: linear-gradient(rgba(60,255,160,.018) 1px, transparent 1px) 0 0/100% 30px, #07100b; font-family: 'JetBrains Mono', monospace; }
      .con-winbar { display: flex; align-items: center; gap: .5rem; padding: .7rem 1rem; background: #0a160f; border-bottom: 1px solid rgba(60,255,160,.14); }
      .con-dot { width: 11px; height: 11px; border-radius: 50%; }
      .con-dot.r { background: #ff5f57; } .con-dot.y { background: #febc2e; } .con-dot.g { background: #28c840; }
      .con-path { margin-left: .75rem; color: #5f8a72; font-size: .78rem; }
      .con-body { display: grid; grid-template-columns: 190px 1fr; min-height: 60vh; }
      .con-side { padding: 1.25rem 1rem; border-right: 1px solid rgba(60,255,160,.12); }
      .con-side-h { font-size: .64rem; letter-spacing: .15em; color: #4f7a64; margin: 0 0 .85rem; }
      .con-side a { display: block; padding: .35rem 0; color: #7fae95; font-size: .82rem; cursor: pointer; }
      .con-side a.on, .con-side a:hover { color: #3dff9f; }
      .con-main { padding: 1.5rem 1.75rem; }
      .con-line { color: #7fae95; font-size: .85rem; margin: 0; }
      .con-prompt { color: #3dff9f; } .con-dir { color: #e6c846; }
      .con-mt { margin-top: 1.5rem; }
      .con-name { color: #eafff3; font-size: clamp(2rem,5vw,3rem); margin: .4rem 0 .2rem; font-weight: 600; }
      .con-roles { color: #5f8a72; font-size: .85rem; margin: 0 0 .75rem; }
      .con-bio { color: #b6d8c5; font-size: .92rem; line-height: 1.6; max-width: 60ch; }
      .con-stack { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
      .con-stack span { display: inline-flex; align-items: center; gap: .4rem; font-size: .78rem; color: #b6d8c5; padding: .3rem .6rem; border: 1px solid rgba(60,255,160,.2); border-radius: 4px; }
      .con-stack svg { width: .95rem; height: .95rem; color: var(--b); }
      .con-proj { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin-top: .75rem; }
      .con-card { padding: 1rem; border: 1px solid rgba(60,255,160,.18); border-radius: 4px; background: rgba(8,20,14,.5); }
      .con-tag { font-size: .68rem; color: #e6c846; }
      .con-card h3 { color: #eafff3; font-size: 1rem; margin: .25rem 0; }
      .con-card p { color: #8fbfa3; font-size: .8rem; margin: 0; }
      .con-cursor { color: #3dff9f; animation: con-blink 1.1s steps(1) infinite; }
      @keyframes con-blink { 50% { opacity: 0; } }
      @media (max-width: 760px) { .con-body { grid-template-columns: 1fr; } .con-side { display: none; } .con-proj { grid-template-columns: 1fr; } }

      @media (max-width: 760px) {
        .pap-hero { grid-template-columns: 1fr; }
        .noc-stats { flex-wrap: wrap; }
      }
    </style>

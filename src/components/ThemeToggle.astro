---
// Theme toggle — sun (switch to light) / moon (switch to dark)
// Uses class-based queries so multiple instances (sidebar + header) all work.
// Script is deduplicated by Astro when identical; re-initialised on astro:page-load.
---

<button
  class="dp-theme-btn"
  aria-label="Toggle light/dark theme"
  title="Toggle theme"
>
  <!-- Sun — soft filled rays (shown in dark mode → click to go light) -->
  <span class="dp-icon dp-icon-sun">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <!-- Core -->
      <circle cx="12" cy="12" r="4.4"/>
      <!-- Cardinal rays (dot style — soft, like a lion's mane) -->
      <circle cx="12" cy="2.2" r="1.35"/>
      <circle cx="12" cy="21.8" r="1.35"/>
      <circle cx="2.2"  cy="12" r="1.35"/>
      <circle cx="21.8" cy="12" r="1.35"/>
      <!-- Diagonal rays, slightly smaller -->
      <circle cx="5.3"  cy="5.3"  r="1.1"/>
      <circle cx="18.7" cy="5.3"  r="1.1"/>
      <circle cx="5.3"  cy="18.7" r="1.1"/>
      <circle cx="18.7" cy="18.7" r="1.1"/>
    </svg>
  </span>

  <!-- Moon — crescent with tiny star accents (shown in light mode → click to go dark) -->
  <span class="dp-icon dp-icon-moon">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" opacity="0.95"/>
      <!-- Soft star accents near the crescent -->
      <circle cx="16.5" cy="5.5"  r="0.85" opacity="0.55"/>
      <circle cx="19.5" cy="10"   r="0.6"  opacity="0.40"/>
      <circle cx="14.5" cy="3"    r="0.65" opacity="0.45"/>
    </svg>
  </span>
</button>

<style>
  .dp-theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--token-radius-md, 10px);
    border: 1px solid var(--token-border);
    background: var(--token-primary-soft);
    color: var(--token-primary);
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.2s ease, color 0.25s ease;
    flex-shrink: 0;
  }
  .dp-theme-btn:hover {
    background: var(--token-primary-soft);
    border-color: var(--token-primary-muted);
    transform: scale(1.06);
  }
  .dp-theme-btn:active { transform: scale(0.96); }

  .dp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
</style>

<script is:inline>
  /* Theme toggle — deduped by Astro when identical inline scripts appear multiple times.
     Re-init on astro:page-load to handle ViewTransitions. */
  (function () {
    function initThemeToggles() {
      var html = document.documentElement;
      var isDark = (html.getAttribute('data-theme') || 'lion') !== 'lion-light';

      function setIcons(dark) {
        document.querySelectorAll('.dp-icon-sun').forEach(function (el) {
          el.style.display = dark ? 'flex' : 'none';
        });
        document.querySelectorAll('.dp-icon-moon').forEach(function (el) {
          el.style.display = dark ? 'none' : 'flex';
        });
      }

      setIcons(isDark);

      document.querySelectorAll('.dp-theme-btn:not([data-dp-bound])').forEach(function (btn) {
        btn.setAttribute('data-dp-bound', '1');
        btn.addEventListener('click', function () {
          var cur  = document.documentElement.getAttribute('data-theme') || 'lion';
          var next = cur === 'lion' ? 'lion-light' : 'lion';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('dp-theme', next);
          setIcons(next !== 'lion-light');
        });
      });
    }

    /* Run on initial page load */
    if (document.readyState !== 'loading') {
      initThemeToggles();
    } else {
      document.addEventListener('DOMContentLoaded', initThemeToggles);
    }

    /* Re-run after every ViewTransition */
    document.addEventListener('astro:page-load', initThemeToggles);
  })();
</script>
